# Copy this file to `.env` before running Docker Compose. Never commit `.env`.
# Values below are placeholders only. Generate a unique JWT key with at least 32 random bytes.

# Required administrator credentials.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-your-chosen-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Optional public browser-to-API URL baked into the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000

# Optional SQLite default. Use MySql with `docker compose --profile mysql up --build`.
DATABASE_PROVIDER=Sqlite
DATABASE_CONNECTION_STRING="Data Source=/data/workshop-tracker.db"

# Required only for the MySQL profile.
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
