# Copy this file to `.env.local` for local frontend development.
# Both values are public browser configuration and MUST NOT contain secrets.

# Optional: use `mock` while developing the frontend without the API.
# Omit it or set it to `api` when connecting to the backend.
NEXT_PUBLIC_API_MODE=mock

# Required when NEXT_PUBLIC_API_MODE is `api`; optional in mock mode.
NEXT_PUBLIC_API_URL=http://localhost:8080
