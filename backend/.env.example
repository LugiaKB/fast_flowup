# Copy this file to `.env` for local backend development. Never commit `.env`.
# All variables below are read at startup. Required variables will cause the
# application to refuse to start if missing or empty.

# ---------------------------------------------------------------------------
# Administrator credentials (REQUIRED)
# ---------------------------------------------------------------------------

# Username for the initial administrator account (1-100 characters).
# Changing this value and restarting will rename the account and revoke
# all active refresh sessions.
ADMIN_USERNAME=replace-with-admin-username

# Password for the initial administrator account.
# You can choose any password. Changing this value and restarting
# will update the password and revoke active refresh sessions.
ADMIN_PASSWORD=replace-with-your-chosen-password

# ---------------------------------------------------------------------------
# JWT signing key (REQUIRED)
# ---------------------------------------------------------------------------

# Secret key used to sign and verify JWT access tokens.
# Must be at least 32 bytes (64 hex characters recommended).
# Generate one with:  openssl rand -hex 32
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# ---------------------------------------------------------------------------
# CORS (REQUIRED)
# The browser origin(s) allowed to call the API (separated by commas or semicolons).
# Example for production: https://fast-flowup.vercel.app
# Supports CORS_ALLOWED_ORIGINS, FrontendOrigin, FRONTEND_ORIGIN, or ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (OPTIONAL — defaults to SQLite)
# ---------------------------------------------------------------------------

# Database provider: Sqlite or MySql
# Default: Sqlite
Database__Provider=Sqlite

# Connection string for the selected provider.
# SQLite example (relative path, created automatically):
ConnectionStrings__DefaultConnection=Data Source=workshop-tracker.db

# MySQL example (uncomment and adjust when Database__Provider=MySql):
# ConnectionStrings__DefaultConnection=Server=localhost;Database=workshop_tracker;User=workshop_user;Password=replace-with-mysql-password

# ---------------------------------------------------------------------------
# ASP.NET Core (OPTIONAL — defaults shown)
# ---------------------------------------------------------------------------

# Hosting environment: Development | Staging | Production
# Development enables Swagger UI and relaxed cookie security.
ASPNETCORE_ENVIRONMENT=Development

# URLs the Kestrel server listens on.
# Default when run via `dotnet run`: https://localhost:7xxx;http://localhost:5xxx
# Override to expose on a specific port:
# ASPNETCORE_URLS=http://localhost:8080
